{
  "openapi": "3.1.0",
  "info": {
    "title": "Peiligo Headless API（只读公开内容）",
    "version": "1.0.0-proposed",
    "summary": "SPEC-001 B01 只读 Headless API 契约",
    "description": "Peiligo 公开内容只读 JSON API 契约（Proposed，待 R3 评审冻结）。人的契约＝docs/api/README.md；本文件是类型生成/校验唯一来源（F04），两载体必须同一提交更新。行为等价基线：peiligo/main = 48fd5d6。实现归属 B02（feature/headless-api，零迁移）。Ticket: https://github.com/luehunnie/peiligo/issues/13；Spec: https://github.com/luehunnie/peiligo-frontend-rebuild/issues/2；ADR: docs/adr/0008-headless-api-contract.md"
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "Peiligo Docker Compose 内网相对路径；Caddy 不公开路由 /api/（浏览器零直接调用，Astro SSR 服务端取数）"
    }
  ],
  "paths": {
    "/chrome": {
      "get": {
        "operationId": "getChrome",
        "summary": "页头/页脚全局 chrome（E1；等价 site_chrome + _active_alert）",
        "description": "nav_sections = home.models.SECTIONS 冻结常量顺序（现状导航零查询同构，不查库）。feedback_email = SiteSettings.feedback_email 优先、settings.FEEDBACK_EMAIL 环境兜底（context_processors._feedback_email 同链）。alert = SiteSettings 紧急提示（空文案/窗口外为 null，_active_alert 同口径）。每请求实时，no-store（紧急告警下一次请求即见）。",
        "responses": {
          "200": {
            "description": "Chrome",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Chrome" } } }
          },
          "500": { "$ref": "#/components/responses/ServerError" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    },
    "/home": {
      "get": {
        "operationId": "getHome",
        "summary": "首页数据（E2；等价 HomePage.get_context，Phase 8C 定稿层级）",
        "description": "可见性 CURRENT_DEFAULT。carousel = _carousel_entries 同口径（is_on_display 每请求复核，失效静默跳过，≤5）；sections = live SectionPage 按 SECTIONS 冻结顺序（与 E1 的常量清单不同，此处查库过滤 live）；campus_news = _campus_news_entries 同一组稿规则：推荐位（创建序）→最新通知（8 条内）→近期活动（4 条内）补位、已结束活动跳过、pk 去重、≤3。summary 截断（60/50 字）在服务端完成，与现状渲染一致。",
        "responses": {
          "200": {
            "description": "首页数据",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Home" } } }
          },
          "500": { "$ref": "#/components/responses/ServerError" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    },
    "/sections/{slug}": {
      "get": {
        "operationId": "getSectionList",
        "summary": "板块默认列表/筛选态（E3；等价 SectionPage.get_context）",
        "description": "可见性 CURRENT_DEFAULT；过滤层与 /search/ 完全同层（search.services：filter-first + order_by_relevance=False 保序，-first_published_at 稳定合并）。非法参数值视同未提供（200 回退全量，CONTENT_MODEL §21.3）；?section= 不读（板块维度由路径唯一决定）。page 宽容语义：非整数→第 1 页，越界→最后一页。slug 非五冻结值或板块页非 live → 404。",
        "parameters": [
          { "$ref": "#/components/parameters/SectionSlug" },
          { "$ref": "#/components/parameters/Q" },
          { "$ref": "#/components/parameters/Dept" },
          { "$ref": "#/components/parameters/Type" },
          { "$ref": "#/components/parameters/Tag" },
          { "$ref": "#/components/parameters/Page" }
        ],
        "responses": {
          "200": {
            "description": "板块列表",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SectionList" } } }
          },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    },
    "/sections/{slug}/archive": {
      "get": {
        "operationId": "getSectionArchive",
        "summary": "板块历史归档（E4；等价 home.views.section_archive）",
        "description": "可见性 HISTORICAL（S2∪S3，ARCHIVE-SEARCH 同谓词）。无查询参数（非 §21 载体，零新增公开参数）；全量返回不分页（现状模板全量渲染同构）；-first_published_at 倒序。slug 非法或板块页非 live → 404。",
        "parameters": [
          { "$ref": "#/components/parameters/SectionSlug" }
        ],
        "responses": {
          "200": {
            "description": "归档条目全量",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SectionArchive" } } }
          },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    },
    "/search": {
      "get": {
        "operationId": "getSearch",
        "summary": "全站搜索（E5；等价 search.views.search）",
        "description": "可见性 HISTORICAL（搜索入口 ARCHIVE-SEARCH：expired 默认命中并带 expired 标记）。五参数 q/section/dept/type/tag + page；非法值视同未提供（200 回退）。q 原样回显（strip 后）＝前端高亮关键词来源；API 不做高亮——前端必须沿用现有安全管线语义（切片→逐片段转义→仅自产 <mark>，见 peiligo_extras.highlight）。无参数（解析后无有效维度）不查全量：entries 恒空（表单态）。chips = section_chips 同构。",
        "parameters": [
          { "$ref": "#/components/parameters/Q" },
          { "$ref": "#/components/parameters/SectionParam" },
          { "$ref": "#/components/parameters/Dept" },
          { "$ref": "#/components/parameters/Type" },
          { "$ref": "#/components/parameters/Tag" },
          { "$ref": "#/components/parameters/Page" }
        ],
        "responses": {
          "200": {
            "description": "搜索结果",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SearchResults" } } }
          },
          "500": { "$ref": "#/components/responses/ServerError" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    },
    "/pages/{section}/{dept}/{slug}": {
      "get": {
        "operationId": "getPageDetail",
        "summary": "内容页详情（E6；等价五类内容页具名 URL 渲染）",
        "description": "路径三段与公开 URL 形态 /<板块>/<部门>/<slug>/ 一一对应（树位置即路径，IA §4.1）。状态语义：live 正常 200；expired 具名 URL 放行且 expired=true（LifecycleStateMixin.route 载体①，页首「已过期」横幅数据即此标记）；S0 草稿/S1 预约发布/S4 已下线 → 404。响应为按 type 判别的联合（oneOf 五 schema）。",
        "parameters": [
          { "$ref": "#/components/parameters/SectionSlug" },
          { "name": "dept", "in": "path", "required": true, "schema": { "type": "string", "description": "部门容器 slug（URL 部门段；容器本身永不渲染，仅路径分组）" } },
          { "name": "slug", "in": "path", "required": true, "schema": { "type": "string", "description": "内容页 slug" } }
        ],
        "responses": {
          "200": {
            "description": "详情（五类之一）",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    { "$ref": "#/components/schemas/NoticeDetail" },
                    { "$ref": "#/components/schemas/ArticleDetail" },
                    { "$ref": "#/components/schemas/MaterialDetail" },
                    { "$ref": "#/components/schemas/SoftwareToolDetail" },
                    { "$ref": "#/components/schemas/GuideDetail" }
                  ]
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    },
    "/link-confirm": {
      "get": {
        "operationId": "getLinkConfirm",
        "summary": "外链确认页四要素（E7；等价 home.views._confirm_context）",
        "description": "每请求实时（永不陈旧面）。校验失败不报 4xx：ok=false + problem 文案（现状确认页渲染拒绝态同构，绝不构造 go_href）。target_domain 仅主机名（external_url_domain 同口径）。source 仅在 from 为数字且所指页 CURRENT_DEFAULT 时返回（防匿名者借 from 枚举草稿标题）。go_href = /link-confirm/go/?url=<quote(target, safe='')>；go 端点本身不属本 API，保持 Django 现状（输出层二次校验 + 302）。",
        "parameters": [
          { "name": "url", "in": "query", "required": false, "schema": { "type": "string", "description": "外部目标 URL（原始输入；服务端按 SB §10-7 全规则校验）" } },
          { "name": "from", "in": "query", "required": false, "schema": { "type": "string", "description": "来源内容页 pk（数字串）" } }
        ],
        "responses": {
          "200": {
            "description": "确认页要素（含拒绝态 ok=false）",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LinkConfirm" } } }
          },
          "500": { "$ref": "#/components/responses/ServerError" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    },
    "/sitemap": {
      "get": {
        "operationId": "getSitemap",
        "summary": "sitemap 条目（E8；等价 wagtail sitemap 视图输出）",
        "description": "与现状 /sitemap.xml 同一模型与排除口径：仅 live；DepartmentContainerPage 整类排除（get_sitemap_urls 返回空）；五类内容页 noindex=true 排除（SeoControlMixin.get_sitemap_urls）。loc 返回路径形态，公开域绝对化由前端完成。",
        "responses": {
          "200": {
            "description": "sitemap 条目",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Sitemap" } } }
          },
          "500": { "$ref": "#/components/responses/ServerError" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    },
    "/preview": {
      "get": {
        "operationId": "getPreview",
        "tags": ["preview-internal"],
        "summary": "预览取数（E9；签名票据门控，内网专用，冻结 PRD「生产切换前 preview 可用」载体）",
        "description": "仅经 Compose 内网由 Astro SSR 调用（Caddy 不公开路由 /api/，无 CORS，浏览器零直接调用）。请求流＝docs/api/README.md §3.1：编辑在后台点「预览」（既有 FormState 表单暂存零变更）→ 应用级钩子铸造签名票据（core.signing，复用 SECRET_KEY＋专用 salt，载荷绑定管理会话/用户/页面 pk，有效期 ≤60s，无新存储载体）→ 编辑浏览器携票据访问同源 /preview/?token=（Astro 渲染）→ Astro 原样透传本端点。Django 校验：签名/时效 → 绑定会话仍存在且仍认证同一用户 → 用户对该页仍具 change 权限（与后台预览同一权限要求）→ 草稿表单态（FormState）仍在；全部通过后只读重建草稿对象、经与 E6 同一序列化层输出 preview:true 响应；任一步失败一律 404（不区分原因，防预言机）。兑换路径零写入（不改 FormState、不写会话/存储）；票据 ≤60s 内可重复兑换为已知残余风险（README §3.1）。响应 no-store；Astro 侧义务：同模板渲染、no-store+X-Robots-Tag: noindex+Referrer-Policy: no-referrer、票据不落访问日志、失败样式化 404、CSP 同全站纪律、不入 sitemap/搜索/导航。范围＝五类内容页（E6 判别联合）；首页/板块页预览维持后台 Django 模板预览现状。",
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "minLength": 32 },
            "description": "后台预览出口铸造的签名票据（有效期 ≤60s；由 Astro 原样透传——Astro 不解析、不校验、不缓存、不落日志）"
          }
        ],
        "responses": {
          "200": {
            "description": "草稿预览数据（E6 五类之一 + 顶层 preview:true；字段取自预览表单状态，可见性谓词不适用）",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PreviewDetail" } } }
          },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "SectionSlug": {
        "name": "slug", "in": "path", "required": true,
        "schema": { "$ref": "#/components/schemas/SectionSlugEnum" },
        "description": "五冻结板块 slug（IA §2）"
      },
      "Q": {
        "name": "q", "in": "query", "required": false,
        "schema": { "type": "string" },
        "description": "搜索词；服务端首尾 strip；空串不进搜索后端（纯 ORM 过滤）"
      },
      "SectionParam": {
        "name": "section", "in": "query", "required": false,
        "schema": { "$ref": "#/components/schemas/SectionSlugEnum" },
        "description": "板块维度（仅 /search/ 接受）；非法值视同未提供"
      },
      "Dept": {
        "name": "dept", "in": "query", "required": false,
        "schema": { "type": "string" },
        "description": "部门 slug（is_active 词表内）；停用/未知视同未提供"
      },
      "Type": {
        "name": "type", "in": "query", "required": false,
        "schema": { "$ref": "#/components/schemas/PageTypeEnum" },
        "description": "内容类型；非法值视同未提供"
      },
      "Tag": {
        "name": "tag", "in": "query", "required": false,
        "schema": { "type": "string" },
        "description": "Tag slug∪name 或 Discipline/MaterialType/Platform/GuideCategory name；词表外视同未提供"
      },
      "Page": {
        "name": "page", "in": "query", "required": false,
        "schema": { "type": "string" },
        "description": "页码；非整数→第 1 页，越界→最后一页（Paginator.get_page 宽容语义）"
      }
    },
    "responses": {
      "NotFound": {
        "description": "资源不存在（含状态∉{live, expired} 的页面）",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "ServerError": {
        "description": "未预期异常",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "Unavailable": {
        "description": "数据库/上游不可用",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string", "enum": ["not_found", "method_not_allowed", "server_error", "unavailable"] },
              "message": { "type": "string", "description": "zh-Hans 面向访客文案；不泄露路径/栈/环境细节" }
            }
          }
        }
      },
      "SectionSlugEnum": { "type": "string", "enum": ["chronicle", "events", "materials", "software", "guide"] },
      "PageTypeEnum": { "type": "string", "enum": ["notice", "article", "material", "software", "guide"] },
      "EventStatusEnum": { "type": "string", "enum": ["upcoming", "ongoing", "ended"], "description": "现有 event_status 三态计算的机器化；中文标签映射 upcoming=即将开始 / ongoing=进行中 / ended=已结束，归前端表示层" },
      "SectionRef": {
        "type": "object",
        "required": ["slug", "title"],
        "properties": {
          "slug": { "$ref": "#/components/schemas/SectionSlugEnum" },
          "title": { "type": "string", "description": "板块页 title（冻结中文名：校园纪事/校园活动/学习资料/软件与工具/校园指南）" }
        }
      },
      "DepartmentRef": {
        "type": "object",
        "required": ["name", "slug"],
        "properties": {
          "name": { "type": "string", "description": "部门名（作者元数据展示，PRD §4.3）" },
          "slug": { "type": "string", "description": "部门 slug（URL 部门段与筛选维度）" }
        }
      },
      "ImageRef": {
        "type": "object",
        "required": ["src", "width", "height", "alt"],
        "properties": {
          "src": { "type": "string", "description": "rendition 路径（/media/...）；全契约仅四处现有规格：width-1600（轮播/hero）、fill-800x520（快讯卡）、width-1120（正文插图）、width-1400（详情封面），零新规格" },
          "width": { "type": "integer" },
          "height": { "type": "integer" },
          "alt": { "type": "string", "description": "装饰用途处调用方传空串（现状模板 alt=\"\" 同构）" }
        }
      },
      "AttachmentRef": {
        "type": "object",
        "required": ["title", "url"],
        "properties": {
          "title": { "type": "string" },
          "url": { "type": "string", "description": "/documents/<id>/<filename>/ 路径（Django 继续直供，不入 API）" },
          "file_size": { "type": ["integer", "null"], "description": "字节；模板 filesizeformat 展示归前端" }
        }
      },
      "ExternalLinkRef": {
        "type": "object",
        "required": ["url", "confirm_href"],
        "properties": {
          "url": { "type": "string", "description": "外部目标原始 URL（SB §10-7 字段层已校验）" },
          "confirm_href": { "type": "string", "description": "确认链 /link-confirm/?url=<quote(url, safe='/')>&from=<page.pk>；构造规则唯一出处与 external_link_jump.html 同口径。前端必须以 confirm_href 为出口，不得自建外链跳转" }
        }
      },
      "Alert": {
        "type": "object",
        "required": ["text"],
        "properties": { "text": { "type": "string", "description": "紧急提示文案（strip 后非空）" } }
      },
      "Pagination": {
        "type": "object",
        "required": ["total", "page", "page_count", "per_page", "has_next", "has_previous"],
        "properties": {
          "total": { "type": "integer", "minimum": 0 },
          "page": { "type": "integer", "minimum": 1 },
          "page_count": { "type": "integer", "minimum": 0 },
          "per_page": { "type": "integer", "const": 20, "description": "LIST_PAGE_SIZE 冻结值（现状 search.services）" },
          "has_next": { "type": "boolean" },
          "has_previous": { "type": "boolean" }
        }
      },
      "FilterConditionsItem": {
        "type": "object",
        "required": ["label", "value"],
        "properties": {
          "label": { "type": "string", "enum": ["关键词", "板块", "部门", "内容类型", "标签"], "description": "active_conditions 冻结标签（IA §11 筛选无匹配空态回显）" },
          "value": { "type": "string" }
        }
      },
      "ListEntry": {
        "type": "object",
        "description": "列表/搜索/归档共享行数据（等价 includes/list_row.html 消费面）。list_summary = summary → license_note → location 回落链解析结果（_content_summary 同序，不截断）；90 字列表截断归前端表示层。",
        "required": ["type", "id", "title", "url", "expired", "section_slug", "section_title", "department_name", "published_at", "event_status", "list_summary"],
        "properties": {
          "type": { "$ref": "#/components/schemas/PageTypeEnum" },
          "id": { "type": "integer" },
          "title": { "type": "string" },
          "url": { "type": "string", "description": "具名 URL 路径 /<板块>/<部门>/<slug>/" },
          "expired": { "type": "boolean", "description": "true 时前端渲染「已过期」徽标（现状 badge-expired 同构）" },
          "section_slug": { "type": ["string", "null"], "description": "树上下文板块 slug（板块短名/tone 映射归前端 SECTION_SHORT/SECTION_TONE 冻结表）" },
          "section_title": { "type": ["string", "null"], "description": "板块标题（跨板块搜索行标注用）" },
          "department_name": { "type": ["string", "null"] },
          "published_at": { "type": ["string", "null"], "format": "date-time", "description": "first_published_at；展示格式 Y-m-d 归前端" },
          "event_status": { "oneOf": [{ "$ref": "#/components/schemas/EventStatusEnum" }, { "type": "null" }] },
          "list_summary": { "type": "string" }
        }
      },
      "SearchChip": {
        "type": "object",
        "description": "section_chips 同构：真实链接、保留其余参数剔除 page/section、「全部」置首",
