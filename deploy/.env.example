# F-09：compose 运行形态环境变量样例（哑值——真实值不入库，00_MASTER_PLAN
# §4.5 秘密纪律）。复制为同目录 .env 后按部署实际填写：
#   cp .env.example .env && vi .env && docker compose up -d --build
#
# 数据库（容器内 postgres 初始化；DATABASE_URL 由 compose 拼装，勿在此写）
POSTGRES_DB=peiligo
POSTGRES_USER=peiligo
POSTGRES_PASSWORD=change-me-long-random

# Django（production settings 必填项）
SECRET_KEY=change-me-django-secret-key-random
ALLOWED_HOSTS=peiligo.example.edu
CSRF_TRUSTED_ORIGINS=https://peiligo.example.edu
# 后台通知邮件等全 URL 基准地址（与 DOMAIN 同源；不带 /admin 与结尾斜杠，终审 L-1）
WAGTAILADMIN_BASE_URL=https://peiligo.example.edu

# 反馈邮箱环境兜底值（正式载体＝后台「站点设置」里的统一反馈邮箱，
# 后台可改、即时生效；此处仅站点设置未填时的缺省，终审 M-1/L-11）
# FEEDBACK_EMAIL=feedback@peiligo.example.edu

# 对外域名（Caddy HTTPS 主机名；零硬编码）
DOMAIN=peiligo.example.edu

# SPEC-001：前端切换/回滚唯一开关（Caddyfile 路由表默认上游）。
#   缺省 web:8000 ＝ v1（Wagtail 整站回根）——部署后公开面与历史行为零变化；
#   置 frontend:4321 ＝ v2（新 Astro 前端回根）。
# cutover：改本值后仅重建入口容器（web/frontend/db/数据面零接触，秒级）：
#   PEILIGO_DEFAULT_UPSTREAM=frontend:4321 docker compose --env-file .env \
#     -f docker-compose.yml up -d --force-recreate caddy
# 回滚：把本值改回 web:8000 后同一条命令（<5 分钟阈值，实测秒级）。
# 本缺省值与 Caddyfile 的 {$PEILIGO_DEFAULT_UPSTREAM:web:8000} 回退值 twins。
# PEILIGO_DEFAULT_UPSTREAM=web:8000

# 可选调参
GUNICORN_WORKERS=2
SCHED_INTERVAL_SECONDS=60
# HSTS 观察期（秒）——首期可取 3600 观察，终态缺省一年（不设即一年）
# HSTS_SECONDS=3600

# 备份（F-12；均经 compose 显式透传进容器）
# BACKUP_ROOT：缺省落在 compose 具名卷 backups（/data/backups，重建容器
# 不丢）；仅当要把备份集落到宿主目录/独立盘时才设置（bind mount 自理）。
# BACKUP_ROOT=/srv/peiligo-backups
# SECONDARY_BACKUP_DIR：独立副本目录——强烈建议指向另一块独立存储
# （NFS/外接盘），不设＝无独立副本（ops_report 将显式 WARN）。
# SECONDARY_BACKUP_DIR=/mnt/backup-nas/peiligo
# OPS_LOG_FILE：可选，把 stdout JSON 日志落成的文件路径喂给 ops_report
# 的 app_errors 信号（不设＝如实报 unknown）。
# OPS_LOG_FILE=/var/log/peiligo/app.json
