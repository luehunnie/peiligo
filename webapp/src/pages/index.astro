---
// 首页（SPEC-001-F05）。等价转写自 v1 home/templates/home/home_page.html。
// 本文件只承担页面编排（冻结层级：Header → 紧急提示（例外性轻量条）→
// Hero 轮播 → 五分类导航 → 校园快讯 → Footer；h1 视觉上由 Hero 大题承担，
// 全页恒一个 h1（visually-hidden 的 page.title））：
//   1. 取数与错误边界（下方数据面说明）；
//   2. 查询参数态 SEO 状态选择（hasQuery → noindex/canonical）；
//   3. 区块组装——区块标记与样式在 src/components/home/：
//      HeroCarousel.astro（Hero 轮播＋轮播控件全局样式）、
//      SectionNav.astro（五分类导航）、CampusNews.astro（校园快讯）、
//      SectionPoster.astro（快讯卡无封面时的板块海报）。
//
// 数据面（契约 4 内容新鲜度）：每请求经 F04 客户端直连 /home 与 /chrome
// （并行取数；chrome 供页头/页脚，home 供内容）——Wagtail 发布在下一次
// 请求即可见，无 Astro 重建。失败分两档（F08 统一错误边界）：
//   - chrome 失败（含基址 fail-closed 配置错误抛错）＝全站取数边界，
//     页头/页脚无从渲染 → v1 templates/500.html 等价最小简中错误页；
//   - chrome 可用而 home 失败且无 ≤5min 陈旧版本可回退（回退由客户端
//     负责，NEVER_STALE 不含 getHome）→ 站内样式化失败态（FailureState，
//     状态 500，刷新重试＝同 URL 重放）。
// 查询参数态 SEO（v1 base.html request.GET 口径）：任一查询参数 →
// noindex ＋ canonical 指向去参基础 URL（其余页面随所属票接入）。
import CampusNews from "../components/home/CampusNews.astro";
import HeroCarousel from "../components/home/HeroCarousel.astro";
import SectionNav from "../components/home/SectionNav.astro";
import FailureState from "../components/system/FailureState.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { unavailableResponse } from "../lib/responses";
import type { Chrome, Home } from "../schemas/api-schema";
import { api } from "../services/api";

let chrome: Chrome | undefined;
let home: Home | undefined;
try {
  const [chromeResult, homeResult] = await Promise.all([
    api.getChrome(),
    api.getHome(),
  ]);
  if (chromeResult.ok) {
    chrome = chromeResult.data;
    if (homeResult.ok) home = homeResult.data;
  }
} catch {
  // 客户端抛错（含基址 fail-closed 配置错误）＝部署边界事故，同一错误边界
}
if (!chrome) {
  // chrome 不可用＝全站取数边界（页头/页脚无从渲染）：保持 v1 最小 500 页
  return unavailableResponse();
}
// 至此 chrome 必可用；home 缺失＝内容失败且无陈旧版本可回退 → 站内失败态
const contentFailed = !home;
if (contentFailed) {
  Astro.response.status = 500;
}
// 刷新重试＝原样重放本请求（恢复后下一请求即 live 内容，契约 4/5）
const retryHref = Astro.url.pathname + Astro.url.search;

const hasQuery = Astro.url.searchParams.toString() !== "";
const canonical = hasQuery ? Astro.url.origin + Astro.url.pathname : undefined;
---

<BaseLayout
  title={home ? home.title : "内容暂时无法加载"}
  chrome={chrome}
  noindex={hasQuery}
  canonical={canonical}
  bodyClass="template-homepage"
>
  {home ? (
    <Fragment>
      {home.alert && (
        <section class="site-alert" role="alert">
          <p>{home.alert.text}</p>
        </section>
      )}

      {/* 页面主标题（视觉上由 Hero 大题承担；轮播条目标题用 h2，全页恒一个 h1） */}
      <h1 class="visually-hidden">{home.title}</h1>

      {home.carousel.length > 0 && <HeroCarousel items={home.carousel} />}
      <SectionNav sections={home.sections} />
      {home.campus_news.length > 0 && <CampusNews items={home.campus_news} />}
    </Fragment>
  ) : (
    // 内容失败且无陈旧版本可回退（F08 统一失败态；HTTP 500 已在前置区设定）
    <FailureState
      title="内容暂时无法加载"
      note="内容服务出现临时故障，请稍后重试。"
      retryHref={retryHref}
    />
  )}
</BaseLayout>

<style>
  /* 紧急提示（例外性轻量条）：v1 peiligo.css「首页」逐字转写。页面级
     区块（数据来自 home.alert，非 Hero/导航/快讯任一子组件），随页面编排
     留在本文件。 */
  .site-alert {
    max-width: var(--wrap);
    margin: 14px auto 0;
    padding: 12px 20px;
    background: var(--amber-soft);
    border-left: 4px solid var(--amber);
    border-radius: 0 12px 12px 0;
    font-size: 14px;
    color: var(--ink);
  }

  .site-alert p {
    margin: 0;
  }
</style>

{/* 轮播脚本：v1 同款 public 静态外链 + defer（v1 base.html body 末尾
    extra_js 形态）。Astro 会把小组件脚本自动内联进 HTML 且无配置可关，
    与严格 CSP（无 unsafe-inline）冲突，故走 public/ 外链形态；is:inline
    仅是 Astro 要求的「免打包」显式标记，产物仍为同源外链脚本，非内联。 */}
<script is:inline src="/carousel.js" defer></script>
