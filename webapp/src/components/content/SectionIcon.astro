---
// 板块身份图标块（SPEC-001-F06）。等价转写自 v1
// templates/includes/section_identity.html（final-reference 定稿同款线性
// 图标 + accent 实心底）。冻结映射（SECTION_IDENTITY）：chronicle=coral
// events=amber materials=blue software=violet guide=teal——仅 CSS 类映射，
// 零数据字段；未识别 slug 不输出（不猜色）。样式 scoped 自包含：
// 与 F05 SectionNav.astro 各自带 v1 .sec-ico 原值，互不依赖。
import { sectionTone } from "../../lib/sections";

interface Props {
  /** 板块 slug（SectionSlug；未识别不渲染） */
  slug: string;
}

const { slug } = Astro.props;
const tone = sectionTone(slug);
---

{tone && (
  <span class:list={["sec-ico", `ico-${tone}`]} aria-hidden="true">
    {slug === "chronicle" && (
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M4 6.5A1.5 1.5 0 0 1 5.5 5H16a1.5 1.5 0 0 1 1.5 1.5v11A1.5 1.5 0 0 1 16 19H5.5A1.5 1.5 0 0 1 4 17.5Z" />
        <path d="M17.5 8H19a1.5 1.5 0 0 1 1.5 1.5v8A1.5 1.5 0 0 1 19 19h-2.6" />
        <path d="M7 9h7M7 12.5h7M7 16h4" />
      </svg>
    )}
    {slug === "events" && (
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z" />
        <line x1="4" y1="22" x2="4" y2="15" />
      </svg>
    )}
    {slug === "materials" && (
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M2 4h6a4 4 0 0 1 4 4v13a3 3 0 0 0-3-3H2z" />
        <path d="M22 4h-6a4 4 0 0 0-4 4v13a3 3 0 0 1 3-3h7z" />
      </svg>
    )}
    {slug === "software" && (
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <rect x="3" y="4" width="18" height="16" rx="2.5" />
        <polyline points="7.5 9.5 10.5 12 7.5 14.5" />
        <line x1="12.5" y1="15.5" x2="16.5" y2="15.5" />
      </svg>
    )}
    {slug === "guide" && (
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <circle cx="12" cy="12" r="9.5" />
        <polygon points="16 8 14 14 8 16 10 10 16 8" />
      </svg>
    )}
  </span>
)}

<style>
  /* v1 peiligo.css「板块身份」逐字转写 */
  .sec-ico {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 42px;
    height: 42px;
    border-radius: 13px;
    color: #fff;
  }

  .sec-ico svg {
    width: 22px;
    height: 22px;
  }

  .ico-jishi {
    background: var(--coral);
  }

  .ico-huodong {
    background: var(--amber);
  }

  .ico-ziliao {
    background: var(--blue);
  }

  .ico-gongju {
    background: var(--violet);
  }

  .ico-zhinan {
    background: var(--teal);
  }
</style>
