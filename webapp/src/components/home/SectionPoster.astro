    <rect x="92" y="150" width="216" height="22" rx="8" fill="#e8590c" />
    <rect x="104" y="128" width="192" height="22" rx="8" fill="#3e7bc2" />
    <rect x="116" y="172" width="168" height="22" rx="8" fill="#1d5a50" />
    <rect
      x="196"
      y="58"
      width="12"
      height="70"
      rx="6"
      fill="#1d5a50"
      opacity=".85"
    />
    <circle cx="202" cy="52" r="14" fill="#7a5fc9" />
    <rect
