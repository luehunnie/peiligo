---
// 快讯卡无封面时的板块海报（SPEC-001-F05）。等价转写自 v1
// home/templates/home/home_page.html 各板块缺省占位 SVG（400×260 几何
// 海报，与 peiligo.css「板块身份」同源配色）。未识别 slug／无板块 →
// 不渲染任何图形，仅留 .news-art 的 teal-soft 底（v1 同口径）。
// 仅供 CampusNews.astro 使用；尺寸与过渡样式由消费方的 .news-art 承担。
interface Props {
  /** 板块 slug（campus_news.section_slug；null＝无板块归属） */
  slug: string | null;
}

const { slug } = Astro.props;
---

{slug === "chronicle" && (
  <svg
    viewBox="0 0 400 260"
    preserveAspectRatio="xMidYMid slice"
    aria-hidden="true"
    focusable="false"
  >
    <rect width="400" height="260" fill="#fdeee4" />
    <circle cx="332" cy="58" r="34" fill="#ffc940" />
    <rect x="96" y="74" width="208" height="132" rx="18" fill="#e8590c" />
    <rect x="168" y="58" width="64" height="26" rx="10" fill="#c74a08" />
    <circle cx="200" cy="140" r="42" fill="#fff" />
    <circle cx="200" cy="140" r="24" fill="#1d5a50" />
    <circle cx="188" cy="128" r="7" fill="#fff" opacity=".9" />
    <rect
      x="66"
      y="196"
      width="268"
      height="10"
      rx="5"
      fill="#1d5a50"
      opacity=".85"
    />
  </svg>
)}
{slug === "events" && (
  <svg
    viewBox="0 0 400 260"
    preserveAspectRatio="xMidYMid slice"
    aria-hidden="true"
    focusable="false"
  >
    <rect width="400" height="260" fill="#fdf3e0" />
    <circle cx="66" cy="196" r="30" fill="#e8590c" opacity=".85" />
    <rect
      x="104"
      y="52"
      width="192"
      height="118"
      rx="12"
      fill="#fff"
      stroke="#1d5a50"
      stroke-width="6"
    />
    <circle cx="200" cy="111" r="26" fill="#2f7a6e" />
    <path d="M194 99v24l20-12z" fill="#fff" />
    <path
      d="M150 170l-16 34M250 170l16 34"
      stroke="#1d5a50"
      stroke-width="6"
      stroke-linecap="round"
    />
    <rect
      x="60"
      y="212"
      width="280"
      height="10"
      rx="5"
      fill="#1d5a50"
      opacity=".85"
    />
  </svg>
)}
{slug === "materials" && (
