{
  "name": "peiligo-frontend-rebuild",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check:csp": "node scripts/check-csp.mjs",
    "preview": "astro preview",
    "check": "astro sync && astro check",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "licenses:check": "node scripts/check-licenses.mjs",
    "audit:size": "node scripts/audit-source-size.mjs",
    "licenses:write": "node scripts/check-licenses.mjs --write"
  },
  "dependencies": {
    "@astrojs/node": "11.1.5",
    "ajv": "8.20.0",
    "astro": "7.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.1",
    "eslint": "10.10.0",
    "eslint-plugin-astro": "3.1.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "1.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "esbuild": true
  }
}
